{
    "version": 2,
    "builds": [
        {
            "src": "app.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/driver/(.*)",
            "dest": "app.py"
        },
        {
            "src": "/track/(.*)",
            "dest": "app.py"
        },
        {
            "src": "/track",
            "dest": "app.py"
        },
        {
            "src": "/(.*)",
            "dest": "app.py"
        }
    ],
    "env": {
        "FORCE_UPDATE": "true"
    }
}